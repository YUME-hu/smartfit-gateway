# 复制为 .env 后填写
# 注意：VITE_ 变量会被打进前端产物，属公开信息，只能放 publishable / anon key
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
VITE_DEVICE_ID=watch-01

# 里程碑成就 SBT 合约地址（部署到 Sepolia 后填这里）
# 留空时"上链铭刻"按钮会显示"未配置合约地址"
VITE_ACHIEVEMENT_CONTRACT=0x0000000000000000000000000000000000000000
