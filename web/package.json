{
  "name": "smartfit-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SmartFit 实时看板：订阅 Supabase device_latest，展示步数与合模量；含 MediaPipe 深蹲识别",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test tests/squatCounter.test.cjs tests/petRules.test.cjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@supabase/supabase-js": "^2.45.0",
    "echarts": "^5.5.1",
    "ethers": "^6.17.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
