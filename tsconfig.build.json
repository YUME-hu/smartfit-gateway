{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".tmp/js",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/gateway/**/*.ts", "types/**/*.d.ts"]
}
