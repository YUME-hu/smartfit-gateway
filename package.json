{
  "name": "app-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ESP32 手表 → 手机网关 → Supabase → Vue3 看板",
  "scripts": {
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.build.json && node scripts/ensure-cjs-package.cjs tsconfig.build.json",
    "check:sfc": "node scripts/check-sfc.cjs",
    "check:workflow": "node scripts/check-workflow.cjs",
    "check:uniapp": "node scripts/check-uniapp.cjs",
    "test": "npm run build:test && node --test tests/gateway.test.cjs tests/frame.test.cjs",
    "verify": "npm run typecheck && npm run check:sfc && npm run check:workflow && npm run check:uniapp && npm test",
    "verify:db": "node scripts/verify-db.cjs",
    "verify:rt": "node scripts/verify-realtime.cjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030620261112001"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030620261112001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030620261112001",
    "@supabase/supabase-js": "^2.45.0",
    "js-yaml": "^5.5.0",
    "pg": "^8.23.1",
    "supabase": "^3.1.0",
    "typescript": "^5.6.0",
    "vite": "5.2.8",
    "vue": "3.4.21",
    "vue-i18n": "^9.14.0"
  }
}
