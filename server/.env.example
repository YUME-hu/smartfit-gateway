# 复制为 .env（或直接设置环境变量）后启动签名服务

# ⚠️ 测试网专用私钥，绝不能是真钱钱包
# 用 node -e "console.log(require('ethers').Wallet.createRandom().privateKey)" 生成一个
SIGNER_PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY

# 数据库连接串（Supabase 连接池地址）
# ⚠️ 不要带 sslmode：除 verify-full 外任何取值都会被拒绝启动。原因是 pg 会把连接串
#    解析结果叠加到下面的显式 ssl 配置上（sslmode=no-verify 能把校验关掉）。
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# 数据库 TLS 的 CA。两种写法都行：
#   1) 文件路径（相对 server/，推荐；团队与 CI 统一）：
#        SUPABASE_CA_CERT=./certs/supabase-root.pem
#   2) 直接贴 PEM（换行写成字面量 \n）：
#        SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIDdz...\n-----END CERTIFICATE-----\n"
# 留空 = 用 Node 的系统 CA 库（只有公开 CA 签发的服务端才够用）。
# Supabase 连接池用的是自家 CA（Supabase Root 2021 CA，自签，系统 CA 验不过），
# 所以连 pooler 必须配这个；仓库里已带一份公开根证书 server/certs/supabase-root.pem。
# 直连地址（db.<ref>.supabase.co，公开 CA 签发）则留空走系统 CA。
# 不配而证书又验不过时，连接会**直接失败**（不会静默降级成"不校验"）。
# ⚠️ 只放公开根证书；私钥、客户端证书永远不要进仓库。
SUPABASE_CA_CERT=./certs/supabase-root.pem

# 部署后的合约地址（Remix 部署完复制过来）
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 可选
CHAIN_ID=11155111
DEVICE_ID=watch-01
PORT=8787
MIN_EXP=300
MIN_STEPS=5000
DEADLINE_SECONDS=600
