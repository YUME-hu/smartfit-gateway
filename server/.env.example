# 复制为 .env（或直接设置环境变量）后启动签名服务

# ⚠️ 测试网专用私钥，绝不能是真钱钱包
# 用 node -e "console.log(require('ethers').Wallet.createRandom().privateKey)" 生成一个
SIGNER_PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY

# 数据库连接串（Supabase 连接池地址）
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# 部署后的合约地址（Remix 部署完复制过来）
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 可选
CHAIN_ID=11155111
DEVICE_ID=watch-01
PORT=8787
MIN_EXP=300
MIN_STEPS=5000
DEADLINE_SECONDS=600
