# 复制为 .env（或直接设置环境变量）后启动签名服务

# ⚠️ 测试网专用私钥，绝不能是真钱钱包
# 用 node -e "console.log(require('ethers').Wallet.createRandom().privateKey)" 生成一个
SIGNER_PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY

# 数据库连接串（Supabase 连接池地址）
# ⚠️ 不要带 sslmode：除 verify-full 外任何取值都会被拒绝启动。原因是 pg 会把连接串
#    解析结果叠加到下面的显式 ssl 配置上（sslmode=no-verify 能把校验关掉）。
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# 数据库 TLS 的 CA 证书（PEM 字符串）。
# 留空 = 用 Node 的系统 CA 库校验服务端证书（公开 CA 签发的实例就够）。
# 需要填的情况：服务端证书不是公开 CA 签发 —— 例如 Supabase 连接池用的是自家 CA，
# 或本地 `supabase start` 的自签证书。不填而服务端证书又验不过，连接会**直接失败**
# （这是设计选择：不会静默降级成"不校验"）。
# 写法：单行，把 PEM 的换行写成字面量 \n
#   SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIDdzCCAl+gAwIBAgIE...\n-----END CERTIFICATE-----\n"
# ⚠️ 不要把真实的私有证书/私钥提交进仓库，这里只留变量名与占位符。
# SUPABASE_CA_CERT=

# 部署后的合约地址（Remix 部署完复制过来）
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 可选
CHAIN_ID=11155111
DEVICE_ID=watch-01
PORT=8787
MIN_EXP=300
MIN_STEPS=5000
DEADLINE_SECONDS=600
